{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://popozuda-site-production.up.railway.app/api/$1"
    },
    {
      "src": "^/health$",
      "dest": "https://popozuda-site-production.up.railway.app/health"
    },
    {
      "src": "^/products/lisinha$",
      "dest": "/lisinha.html"
    },
    {
      "src": "^/products/popozuda-cream$",
      "dest": "/creme.html"
    },
    {
      "src": "^/products/spray-popozuda$",
      "dest": "/spray.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
